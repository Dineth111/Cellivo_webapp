# --- Required: the server refuses to start without these two ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ht4tsrw.mongodb.net/cellivo?retryWrites=true&w=majority&appName=Cluster0
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Optional (defaults shown) ---
PORT=5000
NODE_ENV=development            # development | production | test. Stack traces only in development
CLIENT_URL=http://localhost:3000 # CORS origin and base of invite / reset links
ACCESS_TOKEN_TTL=15m            # access token lifetime (sessions are refreshed with the refresh token)
AUTH_RATE_LIMIT_MAX=100         # requests per 15 min per IP on /api/auth/*
TRUST_PROXY=0                   # set to 1 behind one reverse proxy so rate limiting sees real client IPs
TRIAL_DAYS=14                   # trial length for new tenants (Dev 2 moves this to platform settings)
